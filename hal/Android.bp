// cityman iris face HAL: android.hardware.biometrics.face V4 (IFace/default) backed by the
// Lumia 950 XL iris camera, the PMI8994 IR emitter and libcitymaniris_engine.

cc_binary {
    name: "android.hardware.biometrics.face-service.cityman",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.face-service.cityman.rc"],
    vintf_fragments: ["android.hardware.biometrics.face-service.cityman.xml"],
    srcs: [
        "src/Face.cpp",
        "src/IrLed.cpp",
        "src/IrisCamera.cpp",
        "src/IrisPipeline.cpp",
        "src/Session.cpp",
        "src/Timing.cpp",
        "src/TemplateStore.cpp",
        "src/Preview.cpp",
        "src/PreviewSink.cpp",
        "src/main.cpp",
    ],
    local_include_dirs: ["src"],
    // FaceEnrollOptions carries an android.view.Surface (NDK backend header lives here).
    include_dirs: ["frameworks/native/aidl/gui"],
    shared_libs: [
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.face-V4-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk_vendor",
        "libcitymaniris_engine",
        "libcrypto",
        "liblog",
        "libmediandk",
        "libnativewindow",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
